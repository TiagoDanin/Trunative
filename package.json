{
  "name": "trunative",
  "version": "1.0.0",
  "description": "A mobile-only design skill for AI coding agents",
  "license": "MIT",
  "author": "Tiago Danin",
  "repository": {
    "type": "git",
    "url": "https://github.com/TiagoDanin/Trunative.git"
  },
  "type": "module",
  "bin": {
